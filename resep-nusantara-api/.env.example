DATABASE_URL=postgresql://user:pass@host:port/db
JWT_SECRET=isi_dengan_secret_random

# Unsplash (https://unsplash.com/oauth/applications) - dipakai oleh
# seed/fetch-images.js untuk mengisi image_url resep & bumbu.
# Hanya Access Key yang dipakai untuk request pencarian foto publik;
# Secret Key hanya diperlukan untuk alur OAuth (tidak dipakai di sini).
UNSPLASH_ACCESS_KEY=isi_dengan_unsplash_access_key
UNSPLASH_SECRET_KEY=isi_dengan_unsplash_secret_key
